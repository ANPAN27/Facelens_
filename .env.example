REVERSE_SEARCH_API_KEY=your_serpapi_key_here
REVERSE_SEARCH_PROVIDER=serpapi
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY=your_private_key_here
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Google Custom Search Engine (free 100 searches/day) — fallback for social
# profile discovery when SerpAPI quota is exhausted.
# Get them at https://programmablesearchengine.google.com/ then Google Cloud
# Console > "Custom Search API" > Create credentials (API key).
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# Face-only query default (true). Set false to search the whole image.
FACE_FIRST_SEARCH=true

# After profile discovery, compare the input face against each profile's
# avatar and report similarity. Set false to skip.
FACE_PROFILE_VERIFY=true